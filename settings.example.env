# Around the Grounds: settings for the box itself. The club, colours, logo,
# sponsors and timings are all chosen on the setup page (http://<box>:8080/setup).
# After changing this file:  sudo systemctl restart around-the-grounds around-the-grounds-kiosk

# The web server. 0.0.0.0 lets phones on the same Wi-Fi open the scoreboard and setup page.
ATG_HOST=0.0.0.0
ATG_PORT=8080

# The setup hotspot, opened when the box can't find a Wi-Fi network.
# The password needs at least 8 characters.
ATG_HOTSPOT_SSID=AroundTheGrounds-Setup
ATG_HOTSPOT_PASSWORD=scoreboard
