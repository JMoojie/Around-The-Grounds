# Around the Grounds settings. On the Pi, copy to settings.env (setup.sh does this)
# and restart afterwards:  sudo systemctl restart around-the-grounds around-the-grounds-kiosk

# The club, as PlayCricket knows it.
ATG_CLUB_ID=c88df151-87d8-eb11-a7ad-2818780da0cc
ATG_CLUB_NAME=Altona Roosters
ATG_SHORT_NAME=Roosters
ATG_TIMEZONE=Australia/Melbourne

# The web server. 0.0.0.0 lets phones on the same Wi-Fi open the scoreboard too.
ATG_HOST=0.0.0.0
ATG_PORT=8080

# Seconds between score checks, and on each page when there's more than one.
ATG_REFRESH_SECONDS=60
ATG_PAGE_SECONDS=20
